; }\n48\thtml {\n49\t  -webkit-text-size-adjust: 100%;\n50\t  text-size-adjust: 100%;\n51\t  scroll-padding-top: var(--anchor-offset);\n52\t}\n53\t@media (prefers-reduced-motion: no-preference) {\n54\t  html { scroll-behavior: smooth; }\n55\t}\n56\tbody {\n57\t  margin: 0;\n58\t  background: var(--background-canvas);\n59\t  color: var(--text-primary);\n60\t  font-family: var(--stack-text);\n61\t  font-size: var(--size-base);\n62\t  line-height: var(--leading-body);\n63\t  -webkit-font-smoothing: antialiased;\n64\t  text-rendering: optimizeLegibility;\n65\t  overflow-x: clip;\n66\t}\n67\tbody.is-locked { overflow: hidden; }\n68\timg, svg { display: block; max-width: 100%; }\n69\th1, h2, h3, p, ul, figure { margin: 0; }\n70\t:where(ul[role=\"list\"]) { list-style: none; padding: 0; }\n71\ta { color: inherit; text-decoration-thickness: 1px; text-underline-offset: 0.2em; }\n72\tbutton { font: inherit; color: inherit; cursor: pointer; }\n73\tbutton:disabled { cursor: not-allowed; }\n74\tsvg[aria-hidden] { width: 24px; height: 24px; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; flex: none; }\n75\t:focus-visible { outline: var(--focus-width) solid var(--focus-ring); outline-offset: var(--focus-offset); }\n76\t#conteudo:focus { outline: none; }\n77\t\n78\t.wrap { width: 100%; max-width: var(--container); margin-inline: auto; padding-inline: var(--gutter); }\n79\t.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }\n80\t.skip { position: absolute; left: var(--space-4); top: -100px; z-index: 100; padding: var(--space-3) var(--space-4); background: var(--background-inverse); color: var(--text-inverse); border-radius: var(--radius-sm); }\n81\t.skip:focus { top: var(--space-4); }\n82\t\n83\t/* ---------- Tipografia utilitária ---------- */\n84\t.kicker {\n85\t  font-size: var(--size-xs);\n86\t  font-weight: var(--weight-semib