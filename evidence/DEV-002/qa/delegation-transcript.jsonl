{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RwcGzmgeBsYEXzdUJMG4MS","type":"tool_result","content":"1\t#!/usr/bin/env python3\n2\t\"\"\"Gera site/index.html da loja demonstrativa do Ateliê Bruma (marca fictícia).\n3\t\n4\tO catálogo (CATALOGO) é a única fonte dos produtos: cada vitrine, a faixa de\n5\tcategorias e os dados da sacola saem daqui. Estilo em site/styles.css,\n6\tcomportamento em site/app.js. Ilustrações em scripts/gerar_pecas.py.\n7\t\n8\tUso: python3 scripts/gerar_site.py\n9\t\"\"\"\n10\tfrom __future__ import annotations\n11\t\n12\tfrom html import escape\n13\tfrom pathlib import Path\n14\t\n15\tROOT = Path(__file__).resolve().parents[1]\n16\t\n17\tCOLECOES = [\n18\t    {\n19\t        \"id\": \"nevoa\", \"nome\": \"Névoa\", \"estacao\": \"Primavera 2026\", \"atual\": True,\n20\t        \"frase\": \"Esmalte fosco cinza-azulado, com uma névoa clara que escorre da borda. A fornada da estação.\",\n21\t    },\n22\t    {\n23\t        \"id\": \"terra\", \"nome\": \"Terra Molhada\", \"estacao\": \"Outono 2026\", \"atual\": False,\n24\t        \"frase\": \"Óxido de ferro sobre argila escura: ferrugem embaixo, areia molhada em cima.\",\n25\t    },\n26\t    {\n27\t        \"id\": \"sal\", \"nome\": \"Sal\", \"estacao\": \"Verão 2025/26\", \"atual\": False,\n28\t        \"frase\": \"Branco quente de sal grosso, com a borda mergulhada em azul cobalto.\",\n29\t    },\n30\t]\n31\t\n32\tCATEGORIAS = [\n33\t    {\"id\": \"canecas\", \"nome\": \"Canecas e xícaras\", \"formas\": [\"caneca\", \"xicara\", \"copo\"], \"arte\": \"nevoa-caneca\"},\n34\t    {\"id\": \"pratos\", \"nome\": \"Pratos\", \"formas\": [\"prato\"], \"arte\": \"sal-prato\"},\n35\t    {\"id\": \"tigelas\", \"nome\": \"Tigelas\", \"formas\": [\"tigela\", \"ramequim\"], \"arte\": \"terra-tigela\"},\n36\t    {\"id\": \"travessas\", \"nome\": \"Travessas\", \"formas\": [\"travessa\"], \"arte\": \"nevoa-travessa\"},\n37\t    {\"id\": \"vasos\", \"nome\": \"Vasos e jarras\", \"formas\": [\"garrafa\", \"bojudo\", \"jarra\"], \"arte\": \"terra-bojudo\"},\n38\t]\n39\t\n40\t# (colecao, forma, nome, medida, preco, selo)  selo: \"novo\" | \"esgotado\" | \"\"\n41\tCATALOGO = [\n42\t    (\"nevoa\", \"caneca\", \"Caneca Névoa\", \"300 ml\", 98, \"novo\"),\n43\t    (\"nevoa\", \"xicara\", \"Xícara com pires Névoa\", \"120 ml\", 84, \"novo\"),\n44\t    (\"nevoa\", \"tigela\", \"Tigela funda Névoa\", \"Ø 15 cm · 600 ml\", 92, \"\"),\n45\t    (\"nevoa\", \"prato\", \"Prato raso Névoa\", \"Ø 26 cm\", 128, \"\"),\n46\t    (\"nevoa\", \"jarra\", \"Jarra Névoa\", \"1 litro\", 168, \"novo\"),\n47\t    (\"nevoa\", \"garrafa\", \"Vaso garrafa Névoa\", \"altura 22 cm\", 186, \"\"),\n48\t    (\"nevoa\", \"travessa\", \"Travessa oval Névoa\", \"32 × 22 cm\", 210, \"\"),\n49\t    (\"nevoa\", \"copo\", \"Copo Névoa\", \"250 ml\", 72, \"\"),\n50\t    (\"terra\", \"caneca\", \"Caneca Terra Molhada\", \"300 ml\", 98, \"\"),\n51\t    (\"terra\", \"bojudo\", \"Vaso bojudo Terra Molhada\", \"altura 18 cm\", 196, \"\"),\n52\t    (\"terra\", \"tigela\", \"Tigela funda Terra Molhada\", \"Ø 15 cm · 600 ml\", 92, \"\"),\n53\t    (\"terra\", \"prato\", \"Prato raso Terra Molhada\", \"Ø 26 cm\", 128, \"esgotado\"),\n54\t    (\"terra\", \"ramequim\", \"Ramequim Terra Molhada\", \"Ø 9 cm · 150 ml\", 58, \"\"),\n55\t    (\"terra\", \"copo\", \"Copo Terra Molhada\", \"250 ml\", 72, \"\"),\n56\t    (\"sal\", \"xicara\", \"Xícara com pires Sal\", \"120 ml\", 84, \"\"),\n57\t    (\"sal\", \"tigela\", \"Tigela funda Sal\", \"Ø 15 cm · 600 ml\", 92, \"\"),\n58\t    (\"sal\", \"jarra\", \"Jarra Sal\", \"1 litro\", 168, \"\"),\n59\t    (\"sal\", \"prato\", \"Prato raso Sal\", \"Ø 26 cm\", 128, \"\"),\n60\t    (\"sal\", \"travessa\", \"Travessa oval Sal\", \"32 × 22 cm\", 210, \"esgotado\"),\n61\t    (\"sal\", \"ramequim\", \"Ramequim Sal\", \"Ø 9 cm · 150 ml\", 58, \"\"),\n62\t]\n63\t\n64\tFRETE_GRATIS = 299\n65\t\n66\tICON = {\n67\t    \"menu\": '<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M3 6.5h18M3 12h18M3 17.5h12\"/></svg>',\n68\t    \"close\": '<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M5.5 5.5l13 13M18.5 5.5l-13 13\"/></svg>',\n69\t    \"bag\": '<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M5 8.5h14l-1 12H6z\"/><path d=\"M8.75 8.5V7a3.25 3.25 0 0 1 6.5 0v1.5\"/></svg>',\n70\t    \"prev\": '<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M14.5 5.5L8 12l6.5 6.5\"/></svg>',\n71\t    \"next\": '<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M9.5 5.5L16 12l-6.5 6.5\"/></svg>',\n72\t    \"arrow\": '<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13.5 6.5L19 12l-5.5 5.5\"/></svg>',\n73\t    \"truck\": '<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M2.5 6.5h11v10h-11zM13.5 10h4l3 3.2v3.3h-7\"/><circle cx=\"6.5\" cy=\"17.5\" r=\"1.8\"/><circle cx=\"17\" cy=\"17.5\" r=\"1.8\"/></svg>',\n74\t    \"swap\": '<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 8.5h14l-3.5-3.5M20 15.5H6l3.5 3.5\"/></svg>',\n75\t    \"gift\": '<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 10h16v10H4zM3 7h18v3H3zM12 7v13\"/><path d=\"M12 7c-1.5-3-5-3.2-5-1.2S10 7 12 7zm0 0c1.5-3 5-3.2 5-1.2S14 7 12 7z\"/></svg>',\n76\t    \"card\": '<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M2.5 6h19v12h-19zM2.5 10h19M6 14.5h4\"/></svg>',\n77\t    \"plus\": '<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 5v14M5 12h14\"/></svg>',\n78\t}\n79\t\n80\t\n81\tdef brl(v: float) -> str:\n82\t    inteiro, cent = f\"{v:.2f}\".split(\".\")\n83\t    inteiro = f\"{int(inteiro):,}\".replace(\",\", \".\")\n84\t    return f\"R$ {inteiro}\" if cent == \"00\" else f\"R$ {inteiro},{cent}\"\n85\t\n86\t\n87\tdef categoria_de(forma: str) -> str:\n88\t    return next(c[\"id\"] for c in CATEGORIAS if forma in c[\"formas\"])\n89\t\n90\t\n91\tdef card(p: tuple, idx: int) -> str:\n92\t    col, forma, nome, medida, preco, selo = p\n93\t    pid = f\"{col}-{forma}\"\n94\t    esgotado = selo == \"esgotado\"\n95\t    badge = \"\"\n96\t    if selo == \"novo\":\n97\t        badge = '<span class=\"badge\">Novo</span>'\n98\t    elif esgotado:\n99\t        badge = '<span class=\"badge badge--muted\">Esgotado</span>'\n100\t    parcela = \"\"\n101\t    if preco >= 90:\n102\t        parcela = f'<span class=\"price__inst\">3x de {brl(preco / 3)}<span class=\"price__nojuros\"> sem juros</span></span>'\n103\t    if esgotado:\n104\t        btn = '<button class=\"add\" type=\"button\" disabled>Esgotado</button>'\n105\t    else:\n106\t        btn = (\n107\t            f'<button class=\"add\" type=\"button\" data-add=\"{pid}\" data-name=\"{escape(nome)}\" '\n108\t            f'data-price=\"{preco}\" data-img=\"assets/pecas/{pid}.svg\" data-col=\"{col}\">'\n109\t            f'{ICON[\"plus\"]}<span class=\"add__label\">Adicionar à sacola</span></button>'\n110\t        )\n111\t    return f'''          <li class=\"card card--{col}\" data-cat=\"{categoria_de(forma)}\">\n112\t            <div class=\"card__media\">\n113\t              <img src=\"assets/pecas/{pid}.svg\" width=\"400\" height=\"500\" alt=\"\" loading=\"{\"eager\" if idx < 4 and col == \"nevoa\" else \"lazy\"}\" decoding=\"async\">\n114\t              {badge}\n115\t            </div>\n116\t            <div class=\"card__body\">\n117\t              <h3 class=\"card__name\">{escape(nome)}</h3>\n118\t              <p class=\"card__meta\">{escape(medida)} · grés</p>\n119\t              <p class=\"price\"><span class=\"price__val\">{brl(preco)}</span>{parcela}</p>\n120\t              {btn}\n121\t            </div>\n122\t          </li>'''\n123\t\n124\t\n125\tdef vitrine(col: dict, titulo_id: str) -> str:\n126\t    itens = [p for p in CATALOGO if p[0] == col[\"id\"]]\n127\t    cards = \"\\n\".join(card(p, i) for i, p in enumerate(itens))\n128\t    return f'''      <div class=\"carousel\" data-carousel>\n129\t        <div class=\"carousel__nav\" hidden>\n130\t          <button class=\"arrow\" type=\"button\" data-dir=\"-1\" aria-label=\"Peças anteriores\">{ICON[\"prev\"]}</button>\n131\t          <button class=\"arrow\" type=\"button\" data-dir=\"1\" aria-label=\"Próximas peças\">{ICON[\"next\"]}</button>\n132\t        </div>\n133\t        <ul class=\"carousel__track\" role=\"list\" tabindex=\"0\" aria-labelledby=\"{titulo_id}\">\n134\t{cards}\n135\t        </ul>\n136\t        <div class=\"carousel__dots\" hidden></div>\n137\t      </div>'''\n138\t\n139\t\n140\tdef secao_atual() -> str:\n141\t    col = COLECOES[0]\n142\t    return f'''  <section id=\"novidades\" class=\"sec\" aria-labelledby=\"t-novidades\">\n143\t    <div class=\"wrap\">\n144\t      <header class=\"sec__head\">\n145\t        <div>\n146\t          <p class=\"kicker\">Coleção {col[\"nome\"]} · {col[\"estacao\"]}</p>\n147\t          <h2 id=\"t-novidades\" class=\"sec__title\">Novidades da fornada</h2>\n148\t        </div>\n149\t        <p class=\"sec__aside\">{col[\"frase\"]}</p>\n150\t      </header>\n151\t{vitrine(col, \"t-novidades\")}\n152\t    </div>\n153\t  </section>'''\n154\t\n155\t\n156\tdef secao_passadas() -> str:\n157\t    blocos = []\n158\t    for col in COLECOES[1:]:\n159\t        tid = f\"t-col-{col['id']}\"\n160\t        blocos.append(f'''    <div class=\"past past--{col[\"id\"]}\" id=\"colecao-{col[\"id\"]}\">\n161\t      <div class=\"wrap\">\n162\t        <header class=\"sec__head sec__head--past\">\n163\t          <div class=\"past__id\">\n164\t            <span class=\"swatch swatch--{col[\"id\"]}\" aria-hidden=\"true\"></span>\n165\t            <div>\n166\t              <p class=\"kicker\">{col[\"estacao\"]}</p>\n167\t              <h3 id=\"{tid}\" class=\"past__title\">{col[\"nome\"]}</h3>\n168\t            </div>\n169\t          </div>\n170\t          <p class=\"sec__aside\">{col[\"frase\"]}</p>\n171\t        </header>\n172\t{vitrine(col, tid)}\n173\t      </div>\n174\t    </div>''')\n175\t    return f'''  <section id=\"colecoes\" class=\"sec sec--past\" aria-labelledby=\"t-colecoes\">\n176\t    <div class=\"wrap\">\n177\t      <header class=\"sec__intro\">\n178\t        <h2 id=\"t-colecoes\" class=\"sec__title\">Coleções passadas</h2>\n179\t        <p class=\"sec__lead\">Fornadas anteriores que ainda têm peças no ateliê. Cada coleção tem um esmalte só dela.</p>\n180\t      </header>\n181\t    </div>\n182\t{chr(10).join(blocos)}\n183\t  </section>'''\n184\t\n185\t\n186\tdef secao_categorias() -> str:\n187\t    tiles = []\n188\t    for c in CATEGORIAS:\n189\t        n = sum(1 for p in CATALOGO if p[1] in c[\"formas\"])\n190\t        tiles.append(f'''        <li>\n191\t          <a class=\"cat\" href=\"#novidades\" data-filter=\"{c[\"id\"]}\">\n192\t            <span class=\"cat__media\"><img src=\"assets/pecas/{c[\"arte\"]}.svg\" width=\"400\" height=\"500\" alt=\"\" loading=\"lazy\" decoding=\"async\"></span>\n193\t            <span class=\"cat__name\">{c[\"nome\"]}</span>\n194\t            <span class=\"cat__count\">{n} peças</span>\n195\t          </a>\n196\t        </li>''')\n197\t    return f'''  <section id=\"categorias\" class=\"sec sec--cats\" aria-labelledby=\"t-categorias\">\n198\t    <div class=\"wrap\">\n199\t      <header class=\"sec__head\">\n200\t        <h2 id=\"t-categorias\" class=\"sec__title\">Compre por categoria</h2>\n201\t        <p class=\"sec__aside\">Toque numa categoria para ver só essas peças em todas as coleções.</p>\n202\t      </header>\n203\t      <ul class=\"cats\" role=\"list\">\n204\t{chr(10).join(tiles)}\n205\t      </ul>\n206\t    </div>\n207\t  </section>'''\n208\t\n209\t\n210\tdef page() -> str:\n211\t    nav_cats = \"\\n\".join(\n212\t        f'            <li><a href=\"#novidades\" data-filter=\"{c[\"id\"]}\">{c[\"nome\"]}</a></li>' for c in CATEGORIAS\n213\t    )\n214\t    return f'''<!doctype html>\n215\t<html lang=\"pt-BR\">\n216\t<head>\n217\t<meta charset=\"utf-8\">\n218\t<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n219\t<title>Ateliê Bruma | Loja de cerâmica de mesa feita à mão (marca fictícia)</title>\n220\t<meta name=\"description\" content=\"Loja demonstrativa do Ateliê Bruma, marca fictícia de cerâmica de mesa em grés feita à mão. Coleção Névoa e coleções passadas. Nenhuma compra é processada.\">\n221\t<meta name=\"robots\" content=\"noindex\">\n222\t<meta name=\"color-scheme\" content=\"light\">\n223\t<meta name=\"theme-color\" content=\"#F4F1EC\">\n224\t<link rel=\"icon\" type=\"image/svg+xml\" href=\"assets/icone.svg\">\n225\t<link rel=\"preload\" href=\"fonts/fraunces-latin-var.woff2\" as=\"font\" type=\"font/woff2\" crossorigin>\n226\t<link rel=\"preload\" href=\"fonts/figtree-latin-var.woff2\" as=\"font\" type=\"font/woff2\" crossorigin>\n227\t<link rel=\"stylesheet\" href=\"tokens.css\">\n228\t<link rel=\"stylesheet\" href=\"styles.css\">\n229\t<script src=\"app.js\" defer></script>\n230\t</head>\n231\t<body id=\"topo\">\n232\t\n233\t<a class=\"skip\" href=\"#conteudo\">Pular para o conteúdo</a>\n234\t\n235\t<p class=\"announce\">Frete grátis acima de {brl(FRETE_GRATIS)} <span class=\"announce__sep\" aria-hidden=\"true\">·</span> <span class=\"announce__demo\">Loja demonstrativa: nenhuma compra é processada</span></p>\n236\t\n237\t<header class=\"header\" data-header>\n238\t  <div class=\"wrap header__in\">\n239\t    <button class=\"icon-btn header__menu\" type=\"button\" aria-label=\"Abrir menu\" aria-expanded=\"false\" aria-controls=\"menu\" data-open-menu>{ICON[\"menu\"]}</button>\n240\t    <a class=\"brand\" href=\"#topo\"><img src=\"assets/logo-principal.svg\" width=\"101\" height=\"40\" alt=\"Ateliê Bruma\"><span class=\"sr-only\">, início</span></a>\n241\t    <nav class=\"nav\" aria-label=\"Principal\">\n242\t      <ul role=\"list\">\n243\t        <li><a href=\"#novidades\">Novidades</a></li>\n244\t        <li><a href=\"#categorias\">Categorias</a></li>\n245\t        <li><a href=\"#colecoes\">Coleções passadas</a></li>\n246\t        <li><a href=\"#atelie\">O ateliê</a></li>\n247\t        <li><a href=\"#ajuda\">Ajuda</a></li>\n248\t      </ul>\n249\t    </nav>\n250\t    <button class=\"bag-btn\" type=\"button\" aria-controls=\"sacola\" aria-expanded=\"false\" data-open-cart>\n251\t      {ICON[\"bag\"]}<span class=\"bag-btn__label\">Sacola</span><span class=\"bag-btn__count\" data-cart-count>0</span><span class=\"sr-only\" data-cart-count-sr>, 0 itens</span>\n252\t    </button>\n253\t  </div>\n254\t</header>\n255\t\n256\t<div class=\"drawer drawer--left\" id=\"menu\" data-drawer hidden>\n257\t  <div class=\"drawer__scrim\" data-close></div>\n258\t  <div class=\"drawer__panel\" role=\"dialog\" aria-modal=\"true\" aria-label=\"Menu\">\n259\t    <div class=\"drawer__head\">\n260\t      <img src=\"assets/logo-principal.svg\" width=\"81\" height=\"32\" alt=\"Ateliê Bruma\">\n261\t      <button class=\"icon-btn\" type=\"button\" aria-label=\"Fechar menu\" data-close>{ICON[\"close\"]}</button>\n262\t    </div>\n263\t    <nav class=\"mnav\" aria-label=\"Menu do celular\">\n264\t      <ul role=\"list\" class=\"mnav__main\">\n265\t        <li><a href=\"#novidades\">Novidades</a></li>\n266\t        <li><a href=\"#categorias\">Categorias</a>\n267\t          <ul role=\"list\" class=\"mnav__sub\">\n268\t{nav_cats}\n269\t          </ul>\n270\t        </li>\n271\t        <li><a href=\"#colecoes\">Coleções passadas</a>\n272\t          <ul role=\"list\" class=\"mnav__sub\">\n273\t            <li><a href=\"#colecao-terra\">Terra Molhada</a></li>\n274\t            <li><a href=\"#colecao-sal\">Sal</a></li>\n275\t          </ul>\n276\t        </li>\n277\t        <li><a href=\"#atelie\">O ateliê</a></li>\n278\t        <li><a href=\"#ajuda\">Ajuda</a></li>\n279\t      </ul>\n280\t    </nav>\n281\t    <p class=\"drawer__foot\">Frete grátis acima de {brl(FRETE_GRATIS)}. Troca em até 7 dias.</p>\n282\t  </div>\n283\t</div>\n284\t\n285\t<main id=\"conteudo\" tabindex=\"-1\">\n286\t\n287\t  <section class=\"hero\" aria-labelledby=\"t-hero\">\n288\t    <div class=\"hero__stage\" aria-hidden=\"true\">\n289\t      <div class=\"hero__sun\"></div>\n290\t      <p class=\"hero__word\">névoa</p>\n291\t      <div class=\"hero__plinth\"></div>\n292\t      <img class=\"hero__piece hero__piece--a\" src=\"assets/pecas/nevoa-garrafa.svg\" alt=\"\" width=\"400\" height=\"500\">\n293\t      <img class=\"hero__piece hero__piece--b\" src=\"assets/pecas/nevoa-jarra.svg\" alt=\"\" width=\"400\" height=\"500\">\n294\t      <img class=\"hero__piece hero__piece--c\" src=\"assets/pecas/nevoa-tigela.svg\" alt=\"\" width=\"400\" height=\"500\">\n295\t      <img class=\"hero__piece hero__piece--d\" src=\"assets/pecas/nevoa-xicara.svg\" alt=\"\" width=\"400\" height=\"500\">\n296\t      <div class=\"hero__mist hero__mist--1\"></div>\n297\t      <div class=\"hero__mist hero__mist--2\"></div>\n298\t      <div class=\"hero__mist hero__mist--3\"></div>\n299\t      <p class=\"hero__note\">Fornada nº 14 · Curitiba</p>\n300\t    </div>\n301\t    <div class=\"wrap hero__copy\">\n302\t      <p class=\"kicker\">Coleção Névoa · Primavera 2026</p>\n303\t      <h1 id=\"t-hero\" class=\"hero__title\">A névoa<br> virou mesa.</h1>\n304\t      <p class=\"hero__lead\">Grés de alta temperatura, esmalte fosco e uma fornada por mês. Peças feitas à mão para usar todo dia.</p>\n305\t      <div class=\"hero__cta\">\n306\t        <a class=\"btn\" href=\"#novidades\">Comprar a coleção</a>\n307\t        <a class=\"btn-link\" href=\"#categorias\">Ver categorias {ICON[\"arrow\"]}</a>\n308\t      </div>\n309\t    </div>\n310\t  </section>\n311\t\n312\t{secao_categorias()}\n313\t\n314\t  <div class=\"filterbar\" data-filterbar hidden>\n315\t    <div class=\"wrap filterbar__in\">\n316\t      <p>Mostrando: <strong data-filter-name></strong></p>\n317\t      <button class=\"chip\" type=\"button\" data-clear-filter>Limpar filtro {ICON[\"close\"]}</button>\n318\t    </div>\n319\t  </div>\n320\t\n321\t{secao_atual()}\n322\t\n323\t  <section id=\"atelie\" class=\"sec sec--ink\" aria-labelledby=\"t-atelie\">\n324\t    <div class=\"wrap atelie\">\n325\t      <div class=\"atelie__intro\">\n326\t        <p class=\"kicker kicker--inverse\">O ateliê</p>\n327\t        <h2 id=\"t-atelie\" class=\"sec__title\">Uma ceramista, um forno, uma fornada por mês.</h2>\n328\t        <p>Cada peça é torneada e esmaltada à mão em Curitiba. Por isso nenhuma é igual à outra: o esmalte escorre do seu jeito em cada queima.</p>\n329\t      </div>\n330\t      <ul class=\"facts\" role=\"list\">\n331\t        <li><span class=\"facts__num\">1.240 °C</span><span>Queima em alta temperatura: o grés fica resistente e pouco poroso.</span></li>\n332\t        <li><span class=\"facts__num\">Dia a dia</span><span>Vai ao micro-ondas e à lava-louças. Evite choques bruscos de temperatura.</span></li>\n333\t        <li><span class=\"facts__num\">Peça única</span><span>A variação de tom entre peças é parte do desenho, não defeito.</span></li>\n334\t      </ul>\n335\t    </div>\n336\t  </section>\n337\t\n338\t{secao_passadas()}\n339\t\n340\t  <section class=\"perks\" aria-label=\"Vantagens da loja\">\n341\t    <ul class=\"wrap perks__list\" role=\"list\">\n342\t      <li>{ICON[\"truck\"]}<span><strong>Frete grátis</strong> acima de {brl(FRETE_GRATIS)}</span></li>\n343\t      <li>{ICON[\"swap\"]}<span><strong>Troca fácil</strong> em até 7 dias</span></li>\n344\t      <li>{ICON[\"gift\"]}<span><strong>Embalagem para presente</strong> sem custo</span></li>\n345\t      <li>{ICON[\"card\"]}<span><strong>Pix ou cartão</strong> em até 3x sem juros</span></li>\n346\t    </ul>\n347\t  </section>\n348\t\n349\t  <section id=\"ajuda\" class=\"sec\" aria-labelledby=\"t-ajuda\">\n350\t    <div class=\"wrap faq\">\n351\t      <header>\n352\t        <h2 id=\"t-ajuda\" class=\"sec__title\">Ajuda</h2>\n353\t        <p class=\"sec__lead\">Respostas rápidas antes de fechar o pedido.</p>\n354\t      </header>\n355\t      <div class=\"faq__list\">\n356\t        <details id=\"envio\">\n357\t          <summary>Envio e prazos</summary>\n358\t          <p>Postamos em até 3 dias úteis, em caixa com proteção individual para cada peça. O prazo de entrega aparece no fechamento do pedido.</p>\n359\t        </details>\n360\t        <details id=\"trocas\">\n361\t          <summary>Trocas e devoluções</summary>\n362\t          <p>Você tem 7 dias após o recebimento para pedir troca ou devolução, como prevê o Código de Defesa do Consumidor. Se a peça chegar com dano, enviamos outra.</p>\n363\t        </details>\n364\t        <details id=\"cuidados\">\n365\t          <summary>Cuidados com as peças</summary>\n366\t          <p>Grés queimado a 1.240 °C pode ir ao micro-ondas e à lava-louças. Evite tirar a peça da geladeira direto para o forno quente.</p>\n367\t        </details>\n368\t        <details id=\"pagamento\">\n369\t          <summary>Formas de pagamento</summary>\n370\t          <p>Pix ou cartão de crédito em até 3x sem juros, a partir de R$ 90.</p>\n371\t        </details>\n372\t      </div>\n373\t    </div>\n374\t  </section>\n375\t\n376\t</main>\n377\t\n378\t<footer class=\"footer\">\n379\t  <div class=\"wrap footer__grid\">\n380\t    <div class=\"footer__brand\">\n381\t      <img src=\"assets/logo-mono-fundo-escuro.svg\" width=\"101\" height=\"40\" alt=\"Ateliê Bruma\">\n382\t      <p>Cerâmica de mesa feita à mão, em fornadas pequenas.</p>\n383\t    </div>\n384\t    <nav class=\"footer__col\" aria-label=\"Loja\">\n385\t      <h2>Loja</h2>\n386\t      <ul role=\"list\">\n387\t        <li><a href=\"#novidades\">Novidades</a></li>\n388\t        <li><a href=\"#categorias\">Categorias</a></li>\n389\t        <li><a href=\"#colecoes\">Coleções passadas</a></li>\n390\t      </ul>\n391\t    </nav>\n392\t    <nav class=\"footer__col\" aria-label=\"Ajuda\">\n393\t      <h2>Ajuda</h2>\n394\t      <ul role=\"list\">\n395\t        <li><a href=\"#envio\">Envio e prazos</a></li>\n396\t        <li><a href=\"#trocas\">Trocas e devoluções</a></li>\n397\t        <li><a href=\"#cuidados\">Cuidados com as peças</a></li>\n398\t        <li><a href=\"#pagamento\">Pagamento</a></li>\n399\t      </ul>\n400\t    </nav>\n401\t    <p class=\"footer__legal\">Ateliê Bruma é uma marca fictícia criada para um piloto de avaliação. Produtos, preços e políticas são exemplos e nenhuma compra é processada.</p>\n402\t  </div>\n403\t</footer>\n404\t\n405\t<div class=\"drawer drawer--right\" id=\"sacola\" data-drawer hidden>\n406\t  <div class=\"drawer__scrim\" data-close></div>\n407\t  <div class=\"drawer__panel cart\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"t-sacola\">\n408\t    <div class=\"drawer__head\">\n409\t      <h2 id=\"t-sacola\" class=\"cart__title\">Sua sacola</h2>\n410\t      <button class=\"icon-btn\" type=\"button\" aria-label=\"Fechar sacola\" data-close>{ICON[\"close\"]}</button>\n411\t    </div>\n412\t    <div class=\"cart__ship\" data-ship>\n413\t      <p data-ship-text>Faltam {brl(FRETE_GRATIS)} para o frete grátis.</p>\n414\t      <div class=\"cart__bar\"><span data-ship-bar></span></div>\n415\t    </div>\n416\t    <ul class=\"cart__list\" role=\"list\" data-cart-list></ul>\n417\t    <div class=\"cart__empty\" data-cart-empty>\n418\t      <p>Sua sacola está vazia.</p>\n419\t      <a class=\"btn btn--ghost\" href=\"#novidades\" data-close>Ver novidades</a>\n420\t    </div>\n421\t    <div class=\"cart__foot\" data-cart-foot hidden>\n422\t      <p class=\"cart__sum\"><span>Subtotal</span><strong data-cart-subtotal>R$ 0</strong></p>\n423\t      <button class=\"btn btn--block\" type=\"button\" data-checkout>Finalizar compra</button>\n424\t      <p class=\"cart__notice\" data-checkout-notice role=\"status\"></p>\n425\t    </div>\n426\t  </div>\n427\t</div>\n428\t\n429\t<div class=\"toast\" role=\"status\" aria-live=\"polite\" data-toast></div>\n430\t\n431\t<script>window.BRUMA_FRETE_GRATIS = {FRETE_GRATIS};</script>\n432\t</body>\n433\t</html>\n434\t'''\n435\t\n436\t\n437\tdef main() -> None:\n438\t    (ROOT / \"site\" / \"index.html\").write_text(page(), encoding=\"utf-8\")\n439\t   