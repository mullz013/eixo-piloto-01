t  --focus-ring-inverse: var(--fog-50);\n44\t\n45\t  --brand-mark:   var(--ink-900);\n46\t  --brand-accent: var(--clay-700);\n47\t\n48\t  /* ---------- Tipografia ---------- */\n49\t  --font-display: \"Fraunces\", \"Iowan Old Style\", \"Palatino Linotype\", Georgia, serif;\n50\t  --font-text:    \"Figtree\", system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif;\n51\t\n52\t  --weight-light: 300;\n53\t  --weight-regular: 400;\n54\t  --weight-medium: 500;\n55\t  --weight-semibold: 600;\n56\t\n57\t  --size-xs:   0.8125rem;\n58\t  --size-sm:   0.875rem;\n59\t  --size-base: 1.0625rem;\n60\t  --size-lg:   clamp(1.1875rem, 1.1rem + 0.5vw, 1.375rem);\n61\t  --size-h3:   1.375rem;\n62\t  --size-h2:   clamp(1.75rem, 1.4rem + 1.8vw, 2.5rem);\n63\t  --size-h1:   clamp(2.25rem, 1.4rem + 3.2vw, 4rem);\n64\t\n65\t  --leading-tight:   1.1;\n66\t  --leading-heading: 1.2;\n67\t  --leading-ui:      1.4;\n68\t  --leading-body:    1.6;\n69\t\n70\t  --tracking-display: -0.01em;\n71\t  --tracking-label:   0.02em;\n72\t\n73\t  /* ---------- Espaçamento (base 4 px) ---------- */\n74\t  --space-1: 4px;\n75\t  --space-2: 8px;\n76\t  --space-3: 12px;\n77\t  --space-4: 16px;\n78\t  --space-5: 20px;\n79\t  --space-6: 24px;\n80\t  --space-8: 32px;\n81\t  --space-10: 40px;\n82\t  --space-12: 48px;\n83\t  --space-16: 64px;\n84\t  --space-20: 80px;\n85\t  --space-24: 96px;\n86\t  --space-32: 128px;\n87\t\n88\t  /* ---------- Layout ---------- */\n89\t  --gutter: clamp(1rem, 5vw, 2rem);\n90\t  --container: 72rem;\n91\t  --measure: 62ch;\n92\t  --header-height: 56px;\n93\t  --anchor-offset: 5rem;       /* use em scroll-padding-top e scroll-margin-top */\n94\t  --section-y: 64px;           /* mobile; 112px a partir de 1024px (ver abaixo) */\n95\t  --target-min: 24px;\n96\t  --target-comfort: 44px;\n97\t\n98\t  /* ---------- Raio ---------- */\n99\t  --radius-none: 0;\n100\t  --radius-sm: 4px;\n101\t  --radius-md: 10px;\n102\t  --radius-lg: 20px;\n103\t  --radius-arch: 999px 999px 10px 10px;\n104\t  --radius-pill: 999px;\n105\t\n106\t  /* ---------- Foco e bordas ---------- */\n107\t  --focus-width: 3px;\n108\t  --focus-offset: 3px;\n109\t  --focus-offset-tight: 2px;\n110\t  --border-hairline: 1px;\n111\t  --border-dashed-width: 2px;\n112\t\n113\t  /* ---------- Elevação ---------- */\n114\t  --elevation-none: none;\n115\t\n116\t  /* ---------- Movimento ---------- */\n117\t  --motion-fast: 120ms;\n118\t  --motion-base: 200ms;\n119\t  --motion-easing: cubic-bezier(0.2, 0, 0, 1);\n120\t  --scroll-behavior: smooth;\n121\t}\n122\t\n123\t@media (min-width: 1024px) {\n124\t  :root { --section-y: 112px; }\n125\t}\n126\t\n127\t/* Movimento reduzido: nenhuma transição, rolagem imediata (WCAG 2.3.3 como boa prática; AC-NAV-06) */\n128\t@media (prefers-reduced-motion: reduce) {\n129\t  :root {\n130\t    --motion-fast: 0s;\n131\t    --motion-base: 0s;\n132\t    --scroll-behavior: auto;\n133\t  }\n134\t}\n135\t\n136\t/* Uso esperado (referência, não obrigatório aqui):\n137\t   html { scroll-behavior: var(--scroll-behavior); scroll-padding-top: var(--anchor-offset); }\n138\t   :where([id]) { scroll-margin-top: var(--anchor-offset); }\n139\t   :focus-visible { outline: var(--focus-width) solid var(--focus-ring); outline-offset: var(--focus-offset); }\n140\t*/\n141\t"}]},"parent_tool_use_id":"toolu_01N2vYWmdvFp9zsQ4WJYZknN","agent_id":"a3e2e3d95bd3b028d","session_id":"0a8b0875-8aaf-5794-8b9c-63476762e0ac","uuid":"110a1a6d-af3a-46fc-98a1-a6ed0b4c4151","timestamp":"2026-10-22T11:51:40.408Z","tool_result_meta":[{"id":"toolu_013DX9HxLTa5PGzHFEyHdGjE","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}],"subagent_type":"eixo-qa-engineer","task_description":"QA-002 revisão independente DEV-002"}
